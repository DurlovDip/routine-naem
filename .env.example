# Supabase Project Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
# For GitHub Pages, set the same names as repository Actions secrets.
# Leave them blank to keep the public site on this browser only.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Local preview of sign-in and roles without a Supabase project.
# Do not set this in GitHub Actions.
# VITE_AUTH_MOCK=true
